# Supabase (EXPO_PUBLIC_* is required for client-side access in Expo)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Legacy names (optional if you use EXPO_PUBLIC_ above)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# AWS S3 Configuration
AWS_S3_BUCKET=scrollio-videos-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# AI Services (Optional for MVP)
OPENAI_API_KEY=your-openai-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# App Configuration
APP_ENV=development
# Backend API:
# - Web / emulator: http://localhost:3001/api/v1
# - Expo Go on real device: use your PC's LAN IP (phone and PC must be on same WiFi)
#   Windows: ipconfig → IPv4 Address. Example: http://192.168.1.5:3001/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Test credentials (optional, dev only - pre-fills Sign In form)
# EXPO_PUBLIC_TEST_EMAIL=test@scrollio.co
# EXPO_PUBLIC_TEST_PASSWORD=Deneme123.
