# Supabase Configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# AWS S3 Configuration
AWS_S3_BUCKET=scrollio-videos-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# AI Services (Optional for MVP)
OPENAI_API_KEY=your-openai-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# App Configuration
APP_ENV=development
# Backend API (required for Sign In/Sign Up on Expo Go - use your PC's LAN IP)
# Find your IP: ipconfig (Windows) → IPv4 Address. Example: http://192.168.1.5:3000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Test credentials (optional, dev only - pre-fills Sign In form)
# EXPO_PUBLIC_TEST_EMAIL=test@scrollio.co
# EXPO_PUBLIC_TEST_PASSWORD=Deneme123.
