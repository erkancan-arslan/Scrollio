# Supabase (EXPO_PUBLIC_* is required for client-side access in Expo)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Legacy names (optional if you use EXPO_PUBLIC_ above)
SUPABASE_URL=http://localhost:12345
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# AWS S3 Configuration
AWS_S3_BUCKET=scrollio-videos-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# AI Services (Optional for MVP)
OPENAI_API_KEY=your-openai-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# App Configuration
APP_ENV=development
# Backend API (tek satır, tırnak yok, boşluk yok; sonu /api/v1)
# - Expo Web (Chrome, aynı PC): http://localhost:3001/api/v1
# - Expo Go (telefon): PC IPv4 — Windows: ipconfig → Wireless LAN IPv4
#   Örnek: http://192.168.1.5:3001/api/v1  (172.20.x.x hotspot IP sık değişir)
# Yanlış satır kırılınca tarayıcıda http://1/2.x.x.x gibi bozuk URL oluşabilir.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Test credentials (optional, dev only - pre-fills Sign In form)
# EXPO_PUBLIC_TEST_EMAIL=test@scrollio.co
# EXPO_PUBLIC_TEST_PASSWORD=Deneme123.
