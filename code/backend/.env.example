# Kids app: custom mascot pipeline — public HTTPS URL to narration audio (Supabase Storage or CDN).
# Used when merging the generated silent clip with your bundled line ("Hi! I am your mascot…").
# Use double quotes if the URL contains commas or spaces in the path:
# KIDS_CUSTOM_MASCOT_NARRATION_AUDIO_URL="https://....supabase.co/.../file.mp4"
# KIDS_CUSTOM_MASCOT_NARRATION_AUDIO_URL=https://karwgjlvkxqdzozazygd.supabase.co/storage/v1/object/public/reference-videos/audio/ElevenLabs_2026-03-30T03_10_58_Lutz%20-%20Chuckling,%20Giggly%20and%20Cheerful_pvc_sp100_s32_sb75_se5_b_m2.mp4
# If the URL points at an MP4 (or other video container), audio is extracted before mux. For signed URLs
# without a .mp4 suffix in the path, set:
# KIDS_CUSTOM_MASCOT_NARRATION_IS_VIDEO_CONTAINER=true

# Optional: Fal endpoint IDs per custom-mascot step (see kids-custom-mascot-fal-endpoints.ts).
# KIDS_MASCOT_FAL_MODEL_3D=fal-ai/nano-banana-pro/edit
# KIDS_MASCOT_FAL_REFRAMER=fal-ai/image-editing/reframe
# KIDS_MASCOT_FAL_UPSCALER=fal-ai/seedvr/upscale/image
# KIDS_MASCOT_FAL_IMAGE_TO_VIDEO=fal-ai/ltx-video-13b-distilled/image-to-video

